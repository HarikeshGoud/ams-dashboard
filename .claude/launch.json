{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "poc-dashboard",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "5500", "."],
      "port": 5500
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000"],
      "cwd": "backend",
      "port": 8000
    }
  ]
}
